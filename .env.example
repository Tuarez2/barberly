# Copia este archivo como .env y completa los valores.
NODE_ENV=development
PUERTO=3000
# PostgreSQL 17 o superior (D-19). En Railway, Supabase o Neon copia la URL que te dan.
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/barberly
# Al menos 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRETO=
# Origenes separados por comas. La app movil no usa CORS.
ORIGENES_CORS=
# local, memoria o s3
ALMACEN_TIPO=local
# Opcionales (D-03). Si no se definen, valen 15, 30, 5, 5 y 15.
# TOKEN_ACCESO_MINUTOS=15
# TOKEN_RENOVACION_DIAS=30
# REGISTRO_LIMITE_POR_HORA=5
# INICIO_INTENTOS_MAXIMOS=5
# INICIO_ESPERA_MINUTOS=15
# Proxies propios delante de la API (D-15): 0 en local; 1 en Railway, Render o un VPS con Nginx o Caddy.
# PROXIES_CONFIABLES=0
