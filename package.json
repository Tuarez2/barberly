{
  "name": "barberly",
  "version": "0.1.0",
  "private": true,
  "description": "App móvil de citas para barberías con asesor de estilo por IA",
  "workspaces": [
    "apps/*",
    "paquetes/*"
  ],
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "formato": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
