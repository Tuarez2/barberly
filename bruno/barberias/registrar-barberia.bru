meta {
  name: Registrar barbería
  type: http
  seq: 1
}

post {
  url: {{urlBase}}/barberias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAcceso}}
}

body:json {
  {
    "nombre": "Corte Fino",
    "direccion": "Av. Amazonas 123",
    "telefono": "0991234567",
    "descripcion": "Cortes clásicos y modernos"
  }
}

assert {
  res.status: eq 201
  res.body.datos.telefono: eq +593991234567
  res.body.datos.publicada: eq false
  res.body.datos.membresia.rol: eq PROPIETARIO
  res.body.datos.membresia.estado: eq ACTIVO
}

docs {
  AUT-10, HU-AUT-03, D-13. Ejecuta antes autenticacion/Iniciar sesión. Crea la barbería sin publicar (D-07) y la membresía PROPIETARIO ACTIVO en una transacción; vuelve a pedir usuarios/Mi perfil para verla.
}
