# Copia este archivo como .env.prueba y completa los valores.
NODE_ENV=test
PUERTO=3001
# La base debe llamarse barberly_prueba: el globalSetup rechaza cualquier otra.
DATABASE_URL=mysql://USUARIO:CLAVE@localhost:3306/barberly_prueba?allowPublicKeyRetrieval=true
# Al menos 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRETO=
ORIGENES_CORS=
ALMACEN_TIPO=memoria
