# Copia este archivo como .env y completa los valores.
NODE_ENV=development
PUERTO=3000
# allowPublicKeyRetrieval lo pide el conector con el usuario caching_sha2_password de MySQL 8.
DATABASE_URL=mysql://USUARIO:CLAVE@localhost:3306/barberly?allowPublicKeyRetrieval=true
# Al menos 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRETO=
# Origenes separados por comas. La app movil no usa CORS.
ORIGENES_CORS=
# local, memoria o s3
ALMACEN_TIPO=local
